<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_yapcomments</name>
    <author>drek124</author>
    <authorUrl>https://github.com/drek124/</authorUrl>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 drek124. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>1.0.3</version>
    <description>COM_YAPCOMMENTS_XML_DESCRIPTION</description>
    <namespace path="src">Drek124\Component\YapComments</namespace>
    <scriptfile>script.php</scriptfile>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <files folder="site">
        <folder>language</folder>
        <folder>layouts</folder>
        <folder>src</folder>
    </files>

    <media destination="com_yapcomments" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <administration>
        <menu img="class:comments">COM_YAPCOMMENTS</menu>
        <submenu>
            <menu link="option=com_yapcomments&amp;view=dashboard">COM_YAPCOMMENTS_SUBMENU_DASHBOARD</menu>
            <menu link="option=com_yapcomments&amp;view=comments">COM_YAPCOMMENTS_SUBMENU_COMMENTS</menu>
        </submenu>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>forms</folder>
            <folder>language</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
    </administration>
</extension>
